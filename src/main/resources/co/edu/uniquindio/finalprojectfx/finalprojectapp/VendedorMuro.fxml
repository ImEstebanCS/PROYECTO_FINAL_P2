<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="681.0" prefWidth="1169.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.finalprojectfx.finalprojectapp.viewcontroller.VendedorMuroViewController">
    <top>
        <HBox alignment="CENTER" style="-fx-background-color: #2A2A2A;">
           <children>
               <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
                  <image>
                      <Image url="@Image/LM%20(1).png" />
                  </image>
               </ImageView>
               <Label style="-fx-font-size: 24px; -fx-text-fill: white; -fx-font-weight: bold;" text="LUXURY MARKET" />
           </children>
        </HBox>
    </top>
    
    <center>
        <ScrollPane fitToWidth="true">
           <content>
               <VBox spacing="20" style="-fx-background-color: black;">
                   <padding>
                       <Insets bottom="20" left="20" right="20" top="20" />
                   </padding>
                  <children>
                      
                      <!-- Contenedor principal -->
                      <HBox spacing="20">
                         <children>
                             <!-- Panel izquierdo - Información del vendedor -->
                             <VBox maxWidth="300" spacing="10" style="-fx-background-color: #888176; -fx-padding: 15px; -fx-background-radius: 10px;">
                                <children>
                                    <ImageView fitHeight="100" fitWidth="100">
                                       <image>
                                           <Image url="@Image/LM%20(1).png" />
                                       </image>
                                    </ImageView>
                                    
                                    <TextField promptText="NOMBRE" style="-fx-background-color: transparent;" />
                                    <TextField promptText="APELLIDOS" style="-fx-background-color: transparent;" />
                                    <TextField promptText="CEDULA" style="-fx-background-color: transparent;" />
                                    <TextField promptText="DIRECCIÓN" style="-fx-background-color: transparent;" />
                                    <TextField promptText="USUARIO" style="-fx-background-color: transparent;" />
                                    
                                    <!-- Contador de likes -->
                                    <HBox alignment="CENTER" spacing="10">
                                       <children>
                                           <ImageView fitHeight="20" fitWidth="20">
                                              <image>
                                                  <Image url="@heart-icon.png" />
                                              </image>
                                           </ImageView>
                                           <Label text="0 likes" />
                                       </children>
                                    </HBox>
                                    
                                    <!-- Sección de comentarios -->
                                    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5px;">
                                       <children>
                                           <Label text="Comentarios" />
                                           <ListView prefHeight="150" style="-fx-background-color: transparent;" />
                                       </children>
                                    </VBox>
                                </children>
                             </VBox>
                             
                             <!-- Panel central - Productos -->
                             <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <children>
                                    <!-- Tabla de productos propios -->
                                    <TableView editable="true" style="-fx-background-color: #2E2F26;" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn prefWidth="217.0" text="Nombre" />
                                            <TableColumn prefWidth="170.0" text="Categoría" />
                                            <TableColumn minWidth="0.0" prefWidth="128.0" text="Precio" />
                                            <TableColumn prefWidth="226.0" text="Fecha Publicado" />
                                        </columns>
                                    </TableView>
                                    
                                    <!-- Otros vendedores -->
                                    <TilePane hgap="10" style="-fx-background-color: #888176;" vgap="10">
                                       <children>
                                           <VBox maxWidth="200" style="-fx-border-color: #ddd; -fx-padding: 10px; -fx-background-color: #888176;">
                                              <children>
                                                  <Label text="Vendedor 1" />
                                                  <ImageView fitHeight="100" fitWidth="100" />
                                                  <Label text="Productos vendedor 1" />
                                              </children>
                                           </VBox>
                                           <VBox maxWidth="200" style="-fx-border-color: #ddd; -fx-padding: 10px; -fx-background-color: #888176;">
                                              <children>
                                                  <Label text="Vendedor 2" />
                                                  <ImageView fitHeight="100" fitWidth="100" />
                                                  <Label text="Productos vendedor 2" />
                                              </children>
                                           </VBox>
                                       </children>
                                    </TilePane>
                                </children>
                             </VBox>
                             
                             <!-- Panel derecho - Descripción del producto -->
                             <VBox maxWidth="250" style="-fx-background-color: #888176; -fx-padding: 15px; -fx-background-radius: 10px;">
                                <children>
                                    <ImageView fitHeight="100" fitWidth="100">
                                       <image>
                                           <Image url="@star-icon.png" />
                                       </image>
                                    </ImageView>
                                    <TextArea promptText="Descripción del producto seleccionado" style="-fx-background-color: transparent;" wrapText="true" />
                                </children>
                             </VBox>
                         </children>
                      </HBox>
                  </children>
               </VBox>
           </content>
        </ScrollPane>
    </center>
</BorderPane>
